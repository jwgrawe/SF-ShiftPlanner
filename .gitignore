# Python
__pycache__/
*.py[cod]
.venv/
venv/

# The databases (personal data) and SQLite's side files.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3

# Spreadsheets and CSVs anywhere – HR exports, competency forms, downloads
# saved into the app folder by hand – except the committed seed and source
# files re-included below. (Belt and braces: the PC only pulls.)
*.csv
*.xlsx
*.xlsm
*.xls
!data/seed/*.csv

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Never commit real personal data. This repository is PUBLIC.
# data/import/ is where the real HR exports go (Plan/turnus, Ajourhold/ukeplan,
# and later the Excel files managers edit); data/private/ holds the
# anonymiser's key and output. Only the READMEs are tracked.
data/import/*
!data/import/README.md
data/private/*
!data/private/README.md
# data/source/ holds the committed provenance workbooks only; anything new
# dropped here is ignored, so a real export can never slip in by accident.
# The board's own browser profile (run.py --tavle).
data/tavle-profil/
data/source/*
!data/source/Grunnbemanning_funksjonsvis.xlsx
!data/source/Kompetanse_Anonymisert.xlsx
!data/source/Vaktkoder_SF.xlsx
!data/source/Åpningstider_og_vakter_i_SF.xlsx
